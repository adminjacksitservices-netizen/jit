   SCROLL INDICATOR
========================== */

.scroll{
    position:absolute;
    bottom:30px;
    left:50%;
    transform:translateX(-50%);
    color:#fff;
    font-size:14px;
    opacity:.8;
    animation:bounce 2s infinite;
}

@keyframes bounce{
    0%,100%{
        transform:translate(-50%,0);
    }
    50%{
        transform:translate(-50%,10px);
    }
}

