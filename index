    background:#3ca8ff;
    color:#fff;
}

.primary:hover{
    background:#1f89df;
    transform:translateY(-4px);
}

.secondary{
    border:2px solid #fff;
    color:#fff;
}

.secondary:hover{
    background:#fff;
    color:#222;
}

